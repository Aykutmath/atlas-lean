import Section_2_Preliminaries.MomentInversion
import Mathlib.Analysis.Convex.Combination

/-! The finite-law/polytope dictionary. Coordinates include the empty monomial,
whose value is one, and every singleton in the generating support. -/
namespace AlphaCycle
open Classical

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The completed coordinate support generated by three edges. -/
def completedSupport (e : Fin 3 → Finset V) : Finset (Finset V) :=
  Finset.univ.biUnion (fun i => (e i).powerset)

@[simp] theorem mem_completedSupport (e : Fin 3 → Finset V) (s : Finset V) :
    s ∈ completedSupport e ↔ ∃ i, s ⊆ e i := by
  simp [completedSupport]

 theorem mem_completedSupport_of_subset (e : Fin 3 → Finset V)
    (i : Fin 3) (s : Finset V) (hs : s ⊆ e i) : s ∈ completedSupport e :=
  (mem_completedSupport e s).mpr ⟨i, hs⟩

/-- A real vector with one coordinate for every completed monomial. -/
abbrev MomentVector (S : Finset (Finset V)) := {s // s ∈ S} → ℝ

/-- Deterministic Boolean monomial lift. -/
noncomputable def monomialLift (S : Finset (Finset V)) (x : Finset V) : MomentVector S :=
  fun s => if s.val ⊆ x then 1 else 0

/-- The actual convex hull of deterministic monomial vectors. -/
def multilinearPolytope (S : Finset (Finset V)) : Set (MomentVector S) :=
  convexHull ℝ (Set.range (monomialLift S))

/-- A finite law's completed moment vector. -/
noncomputable def momentVector (S : Finset (Finset V)) (μ : BooleanLaw V) : MomentVector S :=
  fun s => moment μ s.val

/-- Finite laws and convex combinations give exactly the same multilinear polytope. -/
 theorem mem_multilinearPolytope_iff (S : Finset (Finset V)) (z : MomentVector S) :
    z ∈ multilinearPolytope S ↔ ∃ μ : BooleanLaw V, momentVector S μ = z := by
  constructor
  · intro hz
    obtain ⟨ι, fi, w, p, hw, htotal, hp, hz⟩ :=
      mem_convexHull_iff_exists_fintype.mp hz
    letI : Fintype ι := fi
    choose a ha using hp
    let ν : Law ι := ⟨w, hw, htotal⟩
    refine ⟨ν.map a, ?_⟩
    funext s
    have hs := congrFun hz s
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at hs
    rw [← hs]
    unfold momentVector moment
    rw [Law.prob_map]
    unfold Law.prob
    apply Finset.sum_congr rfl
    intro i _
    rw [← ha i]
    by_cases h : s.val ⊆ a i <;> simp [ν, monomialLift, h]
  · rintro ⟨μ, rfl⟩
    apply mem_convexHull_of_exists_fintype μ.mass (monomialLift S) μ.nonneg μ.total
    · intro x
      exact Set.mem_range_self x
    · funext s
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      unfold momentVector moment Law.prob monomialLift
      apply Finset.sum_congr rfl
      intro x _
      by_cases h : s.val ⊆ x <;> simp [h]

/-- The complete-edge relaxation requires a law realizing the moments on each edge.
Outside-edge coordinates of a witness law are immaterial; restricting the law to
the edge gives the usual law on that edge's Boolean assignments. -/
def completeEdgeRelaxation (e : Fin 3 → Finset V) :
    Set (MomentVector (completedSupport e)) :=
  {z | ∀ i, ∃ μ : BooleanLaw V, ∀ (s : Finset V) (hs : s ⊆ e i),
    moment μ s = z ⟨s, mem_completedSupport_of_subset e i s hs⟩}

/-- A globally realizable moment vector satisfies all complete-edge constraints. -/
 theorem multilinearPolytope_subset_completeEdgeRelaxation (e : Fin 3 → Finset V) :
    multilinearPolytope (completedSupport e) ⊆ completeEdgeRelaxation e := by
  intro z hz
  obtain ⟨μ, hμ⟩ := (mem_multilinearPolytope_iff _ _).mp hz
  intro i
  refine ⟨μ, ?_⟩
  intro s hs
  exact congrFun hμ ⟨s, mem_completedSupport_of_subset e i s hs⟩

/-- Moments outside a restriction block vanish. -/
 theorem moment_restrict_eq_zero (μ : BooleanLaw V) (e s : Finset V)
    (hse : ¬ s ⊆ e) : moment (restrictLaw μ e) s = 0 := by
  rw [moment, restrictLaw, Law.prob_map]
  convert μ.prob_false using 1
  apply Law.prob_congr
  intro t
  simp only [iff_false]
  intro h
  exact hse ((Finset.subset_inter_iff.mp h).2)

/-- Agreement of subset moments on an overlap implies agreement of the full
restricted distributions there. -/
 theorem restrictLaw_eq_of_moments (μ ν : BooleanLaw V) (e : Finset V)
    (h : ∀ s, s ⊆ e → moment μ s = moment ν s) :
    restrictLaw μ e = restrictLaw ν e := by
  apply law_eq_of_moments
  intro s
  by_cases hs : s ⊆ e
  · rw [moment_restrict μ e s hs, moment_restrict ν e s hs]
    exact h s hs
  · rw [moment_restrict_eq_zero μ e s hs, moment_restrict_eq_zero ν e s hs]

/-- Any family of complete-edge witnesses is automatically consistent on overlaps. -/
 theorem completeEdge_witnesses_consistent (e : Fin 3 → Finset V)
    (z : MomentVector (completedSupport e)) (μ : Fin 3 → BooleanLaw V)
    (hμ : ∀ i s (hs : s ⊆ e i),
      moment (μ i) s = z ⟨s, mem_completedSupport_of_subset e i s hs⟩) :
    ∀ i j, restrictLaw (μ i) (e i ∩ e j) = restrictLaw (μ j) (e i ∩ e j) := by
  intro i j
  apply restrictLaw_eq_of_moments
  intro s hs
  obtain ⟨hi, hj⟩ := Finset.subset_inter_iff.mp hs
  rw [hμ i s hi, hμ j s hj]

/-- The complete-edge relaxation is equivalently described by consistent local
laws realizing the prescribed subset moments. -/
 theorem mem_completeEdgeRelaxation_iff_consistent (e : Fin 3 → Finset V)
    (z : MomentVector (completedSupport e)) :
    z ∈ completeEdgeRelaxation e ↔ ∃ μ : Fin 3 → BooleanLaw V,
      (∀ i s (hs : s ⊆ e i),
        moment (μ i) s = z ⟨s, mem_completedSupport_of_subset e i s hs⟩) ∧
      ∀ i j, restrictLaw (μ i) (e i ∩ e j) = restrictLaw (μ j) (e i ∩ e j) := by
  constructor
  · intro hz
    choose μ hμ using hz
    exact ⟨μ, hμ, completeEdge_witnesses_consistent e z μ hμ⟩
  · rintro ⟨μ, hμ, _⟩ i
    exact ⟨μ i, hμ i⟩

/-- With complete-edge local laws fixed, membership in the multilinear polytope
is exactly existence of a common global realization of their edge restrictions. -/
 theorem mem_multilinearPolytope_iff_realizes (e : Fin 3 → Finset V)
    (z : MomentVector (completedSupport e)) (ν : Fin 3 → BooleanLaw V)
    (hν : ∀ i s (hs : s ⊆ e i),
      moment (ν i) s = z ⟨s, mem_completedSupport_of_subset e i s hs⟩) :
    z ∈ multilinearPolytope (completedSupport e) ↔
      ∃ μ : BooleanLaw V, ∀ i, restrictLaw μ (e i) = restrictLaw (ν i) (e i) := by
  constructor
  · intro hz
    obtain ⟨μ, hμ⟩ := (mem_multilinearPolytope_iff _ _).mp hz
    refine ⟨μ, ?_⟩
    intro i
    apply restrictLaw_eq_of_moments
    intro s hs
    rw [hν i s hs]
    exact congrFun hμ ⟨s, mem_completedSupport_of_subset e i s hs⟩
  · rintro ⟨μ, hμ⟩
    apply (mem_multilinearPolytope_iff _ _).mpr
    refine ⟨μ, ?_⟩
    funext s
    obtain ⟨i, hi⟩ := (mem_completedSupport e s.val).mp s.property
    have h := congrArg (fun ξ => moment ξ s.val) (hμ i)
    rw [moment_restrict μ (e i) s.val hi,
      moment_restrict (ν i) (e i) s.val hi] at h
    exact h.trans (hν i s.val hi)

end AlphaCycle
