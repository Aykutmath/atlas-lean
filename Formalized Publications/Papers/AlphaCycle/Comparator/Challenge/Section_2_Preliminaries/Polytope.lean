import Challenge.Section_2_Preliminaries.MomentInversion
import Mathlib.Analysis.Convex.Combination
/- Challenge excerpt file: byte-identical source excerpts of the listed solution definitions. See Comparator/alpha_cycle_comparator.lean for the independence record. -/

namespace AlphaCycle
open Classical

variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The completed coordinate support generated by three edges. -/
def completedSupport (e : Fin 3 → Finset V) : Finset (Finset V) :=
  Finset.univ.biUnion (fun i => (e i).powerset)
@[simp] theorem mem_completedSupport (e : Fin 3 → Finset V) (s : Finset V) :
    s ∈ completedSupport e ↔ ∃ i, s ⊆ e i := by
  simp [completedSupport]
 theorem mem_completedSupport_of_subset (e : Fin 3 → Finset V)
    (i : Fin 3) (s : Finset V) (hs : s ⊆ e i) : s ∈ completedSupport e :=
  (mem_completedSupport e s).mpr ⟨i, hs⟩
/-- A real vector with one coordinate for every completed monomial. -/
abbrev MomentVector (S : Finset (Finset V)) := {s // s ∈ S} → ℝ
/-- The complete-edge relaxation requires a law realizing the moments on each edge.
Outside-edge coordinates of a witness law are immaterial; restricting the law to
the edge gives the usual law on that edge's Boolean assignments. -/
def completeEdgeRelaxation (e : Fin 3 → Finset V) :
    Set (MomentVector (completedSupport e)) :=
  {z | ∀ i, ∃ μ : BooleanLaw V, ∀ (s : Finset V) (hs : s ⊆ e i),
    moment μ s = z ⟨s, mem_completedSupport_of_subset e i s hs⟩}

end AlphaCycle
