import Section_10_Zonoid.Cor101.Perturbation
import Section_10_Zonoid.Cor101.Sharpness

/-!
# Coordinate-plane area as ordinary two-dimensional volume

This module proves an explicit isometric representation bridge. It does not
assume or prove the determinant formula for the area of a planar zonotope.
-/

open MeasureTheory

noncomputable section

namespace Cor101

/-- The two coordinates retained by the paper's j-th coordinate plane,
in the order (j, final coordinate). -/
def coordinatePair (d : Nat) (j : Fin d) (x : Space d) : Space 1 :=
  WithLp.toLp 2 ![x j.castSucc, x (Fin.last d)]

/-- The actual orthogonal projection is the isometric inclusion of its
ordered coordinate pair. -/
theorem coordinatePlaneProjection_eq_embedding (d : Nat) (j : Fin d) (x : Space d) :
    coordinatePlaneProjection d j x =
      planeEmbeddingLinear d j (coordinatePair d j x) := by
  classical
  rw [planeEmbeddingLinear_apply]
  apply PiLp.ext
  intro i
  change (coordinateSubspace d {j.castSucc, Fin.last d}).starProjection x i = _
  rw [coordinateSubspace_projection_apply]
  by_cases hi : i = j.castSucc
  · subst i
    simp [coordinatePair]
  · by_cases hil : i = Fin.last d
    · subst i
      simp [coordinatePair]
    · simp [coordinatePair, hi, hil]

/-- Projecting a finite zonotope onto E_j gives the isometric image of
the planar zonotope generated by the corresponding coordinate pairs. -/
theorem coordinatePlaneProjection_zonotopeBody
    {d : Nat} {ι : Type*} [Fintype ι] (v : ι → Space d) (j : Fin d) :
    coordinatePlaneProjection d j '' (zonotopeBody v : Set (Space d)) =
      planeEmbeddingLinear d j ''
        (zonotopeBody (fun i => coordinatePair d j (v i)) : Set (Space 1)) := by
  change (coordinatePlaneProjection d j).toLinearMap '' parallelepiped v =
    planeEmbeddingLinear d j '' parallelepiped (fun i => coordinatePair d j (v i))
  rw [image_parallelepiped (coordinatePlaneProjection d j).toLinearMap,
    image_parallelepiped (planeEmbeddingLinear d j)]
  congr 1
  funext i
  exact coordinatePlaneProjection_eq_embedding d j (v i)

/-- The intrinsic area used in the paper equals ordinary two-dimensional
Lebesgue volume of the coordinate-pair zonotope, including degenerate cases. -/
theorem planeVolume_zonotopeBody_eq_fullVolume
    {d : Nat} {ι : Type*} [Fintype ι] (v : ι → Space d) (j : Fin d) :
    planeVolume (zonotopeBody v) j =
      fullVolume (zonotopeBody (fun i => coordinatePair d j (v i))) := by
  unfold planeVolume
  rw [coordinatePlaneProjection_zonotopeBody,
    (planeEmbeddingLinear_isometry d j).euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  rfl

/-- The same representation bridge after applying `ENNReal.toReal`.
This equality alone does not assert finiteness of either measure. -/
theorem planeVolume_zonotopeBody_toReal_eq_fullVolume
    {d : Nat} {ι : Type*} [Fintype ι] (v : ι → Space d) (j : Fin d) :
    (planeVolume (zonotopeBody v) j).toReal =
      (fullVolume (zonotopeBody (fun i => coordinatePair d j (v i)))).toReal := by
  rw [planeVolume_zonotopeBody_eq_fullVolume]

end Cor101
