theorem headNuisanceBad_iff_diffuseInf_lt (j p n : ℕ) (τ B c : ℝ)
    (z : Sample j n × Sample p n) :
    z ∈ headNuisanceBad j p n τ B c ↔
      diffuseInf p n τ B (headNuisanceSpace z.1) z.2 < (c:EReal) := by
  rw [diffuseInf_lt_iff]
  constructor
  · rintro ⟨D,hD,hF,hOp,v,hv,hVB,hbad⟩
    exact ⟨D,⟨hD,hF,hOp⟩,v,hv,hVB,hbad⟩
  · rintro ⟨D,⟨hD,hF,hOp⟩,v,hv,hVB,hbad⟩
    exact ⟨D,hD,hF,hOp,v,hv,hVB,hbad⟩

/-- The actual joint failure of the structural event and tail continuity event. -/
def headJointFailure (j p n : ℕ) (τ B c A : ℝ) : Set (Sample j n × Sample p n) :=
  headNuisanceBad j p n τ B c ∪ {z | (A:EReal) < empiricalSup p n z.2}

/-- Equality with the manuscript's literal complement of the structural
infimum event intersected with the empirical-continuity event. -/
theorem headJointFailure_eq_literal (j p n : ℕ) (τ B c A : ℝ) :
    headJointFailure j p n τ B c A =
      {z : Sample j n × Sample p n |
        (c:EReal) ≤ diffuseInf p n τ B (headNuisanceSpace z.1) z.2 ∧
        empiricalSup p n z.2 ≤ (A:EReal)}ᶜ := by
  ext z
  simp only [headJointFailure,mem_union,headNuisanceBad_iff_diffuseInf_lt,
    mem_setOf_eq,mem_compl_iff,not_and_or,not_le]

theorem empiricalSup_bad_isOpen (j p n : ℕ) (A : ℝ) :
    IsOpen {z : Sample j n × Sample p n | (A:EReal) < empiricalSup p n z.2} := by
  have he : {z : Sample j n × Sample p n | (A:EReal) < empiricalSup p n z.2} =
      ⋃ D : {D : Square p // D.transpose=D ∧ frobeniusNorm D=1},
      {z | A < (1/(n:ℝ))*∑ i, |measurementQ z.2 D.val i|} := by
    ext z
    simp only [mem_setOf_eq,empiricalSup_gt_iff,mem_iUnion,Subtype.exists]
    tauto
  rw [he]
  apply isOpen_iUnion
  intro D
  apply isOpen_lt continuous_const
  unfold measurementQ quadratic Matrix.mulVec dotProduct
  fun_prop

theorem headJointFailure_measurable (j p n : ℕ) (τ B c A : ℝ) (hBn : 0<B*n) :
    MeasurableSet (headJointFailure j p n τ B c A) :=
  ((headNuisanceBad_isOpen j p n τ B c hBn).union (empiricalSup_bad_isOpen j p n A)).measurableSet

/-- Exact complete sample head/tail independence under every orthogonal split. -/
theorem gaussian_head_tail_indep {d j p n : ℕ}
    (e : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin j ⊕ Fin p)) :
    IndepFun (fun x : Sample d n => (gaussianSampleBlockSplit e n x).1)
      (fun x => (gaussianSampleBlockSplit e n x).2) (gaussianSampleLaw d n) := by
  have hp := gaussianSampleBlockSplit_preserving e n
  have hfst := measurePreserving_fst.comp hp
  have hsnd := measurePreserving_snd.comp hp
  apply (indepFun_iff_map_prod_eq_prod_map_map hfst.measurable.aemeasurable hsnd.measurable.aemeasurable).mpr
  rw [hfst.map_eq,hsnd.map_eq]
  exact hp.map_eq

/-- The exact source head sigma-field, generated by all projected head rows. -/
def headSampleSigmaField {d j p : ℕ}
    (e : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin j ⊕ Fin p)) (n : ℕ) :
    MeasurableSpace (Sample d n) :=
  MeasurableSpace.comap (fun x : Sample d n => (gaussianSampleBlockSplit e n x).1) inferInstance

/-- The nuisance projector is measurable for the exact sigma-field generated
by the head rows, not merely for the ambient sample sigma-field. -/
theorem headNuisanceProjector_head_measurable {d j p : ℕ}
    (e : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin j ⊕ Fin p)) (n : ℕ) :
    Measurable[headSampleSigmaField e n]
      (fun x : Sample d n => headNuisanceProjector (gaussianSampleBlockSplit e n x).1) :=
  (measurable_headNuisanceProjector j n).comp (measurable_iff_comap_le.mpr le_rfl)

/-- Actual source conditional probability of the joint failure. The two analytic
bounds are instantiated, rather than supplied as assumptions. The orientation of
E0 is unrestricted. The rank budget is exactly 1+K(K+1)/2. -/
theorem paper_head_joint_conditional (ε B C₁ : ℝ) (hε : 0<ε) (hB : 0<B) (hC₁ : 0<C₁) :
    ∃ A τ c γ : ℝ, 0<A ∧ 0<τ ∧ τ≤1 ∧ 0<c ∧ 0<γ ∧
    ∀ᶠ p : ℕ in atTop, ∀ d j n K : ℕ, j≤K →
      (1/4+ε)*(p:ℝ)^2 ≤ (n:ℝ)-(1+K*(K+1)/2:ℕ) →
      (n:ℝ) ≤ C₁*(p:ℝ)^2 →
      ∀ e : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin j ⊕ Fin p),
      (gaussianSampleLaw d n)[
        {x | gaussianSampleBlockSplit e n x ∈ headJointFailure j p n τ B c A}.indicator
          (1 : Sample d n → ℝ) | headSampleSigmaField e n] ≤ᵐ[gaussianSampleLaw d n]
          fun _ => 3*Real.exp (-γ*(p:ℝ)^2) := by
  obtain ⟨A,hA,havg⟩ := paper_average_z_bound ε hε
  obtain ⟨τ,c,γ,hτ,hτ1,hc,hγ,hdiff⟩ := paper_diffuse_theorem ε B C₁ hε hB hC₁
  let γ' := min γ (1/4+ε)
  have hγ' : 0<γ' := lt_min hγ (by linarith)
  refine ⟨A,τ,c,γ',hA,hτ,hτ1,hc,hγ',?_⟩
  filter_upwards [hdiff,eventually_gt_atTop 0] with p hp hp0
  intro d j n K hj hnlo hnhi e
  have hnlo' : (1/4+ε)*(p:ℝ)^2 ≤ n := hnlo.trans (sub_le_self _ (Nat.cast_nonneg _))
  have hn : 0<(n:ℝ) := (mul_pos (by linarith) (sq_pos_of_pos (Nat.cast_pos.mpr hp0))).trans_le hnlo'
  have hBn : 0<B*n := mul_pos hB hn
  have hsections (g : Sample j n) :
      (gaussianSampleLaw p n).real {w | (g,w) ∈ headJointFailure j p n τ B c A} ≤
        3*Real.exp (-γ'*(p:ℝ)^2) := by
    have hrank : (finrank ℝ (headNuisanceSpace g):ℝ) ≤ (1+K*(K+1)/2:ℕ) := by
      exact_mod_cast headNuisanceSpace_finrank_le_of_le g hj
    have hd := hp n (headNuisanceSpace g) (by linarith) hnhi
    have ha := havg p n hp0 hnlo'
    have hexp1 : Real.exp (-γ*(p:ℝ)^2) ≤ Real.exp (-γ'*(p:ℝ)^2) := by
      apply Real.exp_le_exp.mpr
      simpa only [γ',neg_mul] using neg_le_neg
        (mul_le_mul_of_nonneg_right (min_le_left γ (1/4+ε)) (sq_nonneg (p:ℝ)))
    have hexp2 : Real.exp (-(1/4+ε)*(p:ℝ)^2) ≤ Real.exp (-γ'*(p:ℝ)^2) := by
      apply Real.exp_le_exp.mpr
      simpa only [γ',neg_mul] using neg_le_neg
        (mul_le_mul_of_nonneg_right (min_le_right γ (1/4+ε)) (sq_nonneg (p:ℝ)))
    have hu := measureReal_union_le (μ := gaussianSampleLaw p n)
      {w : Sample p n | diffuseInf p n τ B (headNuisanceSpace g) w < (c:EReal)}
      {w : Sample p n | (A:EReal)<empiricalSup p n w}
    have hevent : {w | (g,w) ∈ headJointFailure j p n τ B c A} =
        {w | diffuseInf p n τ B (headNuisanceSpace g) w < (c:EReal)} ∪
        {w | (A:EReal)<empiricalSup p n w} := by
      ext w
      simp only [headJointFailure,mem_union,mem_setOf_eq,headNuisanceBad_iff_diffuseInf_lt]
    rw [hevent]
    change (gaussianSampleLaw p n).real
      ({w | diffuseInf p n τ B (headNuisanceSpace g) w < (c:EReal)} ∪
        {w | (A:EReal)<empiricalSup p n w}) ≤ _
    linarith
  let H : Sample d n → Sample j n := fun x => (gaussianSampleBlockSplit e n x).1
  let T : Sample d n → Sample p n := fun x => (gaussianSampleBlockSplit e n x).2
  have hsplit := gaussianSampleBlockSplit_preserving e n
  have hH : Measurable H := measurable_fst.comp hsplit.measurable
  have hT : Measurable T := measurable_snd.comp hsplit.measurable
  have hTlaw : (gaussianSampleLaw d n).map T = gaussianSampleLaw p n :=
    (measurePreserving_snd.comp hsplit).map_eq
  have hHm : Measurable[headSampleSigmaField e n] H := measurable_iff_comap_le.mpr le_rfl
  have hm : headSampleSigmaField e n ≤ (inferInstance : MeasurableSpace (Sample d n)) := hH.comap_le
  have hind : Indep (headSampleSigmaField e n) (MeasurableSpace.comap T inferInstance)
      (gaussianSampleLaw d n) := (IndepFun_iff_Indep _ _ _).mp (gaussian_head_tail_indep e)
  have hb := GaussianConditionalBound.condExp_event_le (headSampleSigmaField e n)
    (gaussianSampleLaw d n) hm H T hHm hT hind (headJointFailure j p n τ B c A)
    (headJointFailure_measurable j p n τ B c A hBn)
    (3*Real.exp (-γ'*(p:ℝ)^2)) (by positivity) (by
      rw [hTlaw]
      exact Filter.Eventually.of_forall fun x => by
        have hh := ENNReal.ofReal_le_ofReal (hsections (H x))
        simpa only [Measure.real,ENNReal.ofReal_toReal (measure_ne_top _ _)] using hh)
  exact hb

