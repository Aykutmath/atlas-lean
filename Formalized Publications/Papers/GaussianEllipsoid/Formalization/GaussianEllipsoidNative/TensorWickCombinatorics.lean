import Mathlib.Data.Finite.Card
import Mathlib.Data.Setoid.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic

/-!
Finite combinatorial core of the real two-factor Gaussian covariance comparison.
This file does not assert a Gaussian moment formula. It proves the finite quotient
count, joined-constraint count, and double-sum domination needed after Wick expansion.
-/

noncomputable section
open scoped BigOperators

namespace GaussianTensorMoments

variable {α : Type*}

/-- Number of equivalence classes of a finite index relation. -/
def classCount (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- Coarsening an equivalence relation can only decrease its number of classes. -/
theorem classCount_antitone [Finite α] {s t : Setoid α} (hst : s ≤ t) :
    classCount t ≤ classCount s := by
  apply Nat.card_le_card_of_surjective (Setoid.map_of_le hst)
  intro x
  refine Quotient.inductionOn x ?_
  intro a
  exact ⟨Quotient.mk s a, rfl⟩

/-- A join of pairing constraints has at most either original class count. -/
theorem classCount_join_le [Finite α] (s t : Setoid α) :
    classCount (s ⊔ t) ≤ min (classCount s) (classCount t) := by
  exact le_min (classCount_antitone le_sup_left) (classCount_antitone le_sup_right)

/-- Assignments constant on each class of a relation. -/
def ConstantAssignments (s : Setoid α) (β : Type*) :=
  {f : α → β // ∀ a b, s a b → f a = f b}

/-- Constrained assignments are exactly arbitrary functions on the quotient. -/
def constantAssignmentsEquiv (s : Setoid α) (β : Type*) :
    ConstantAssignments s β ≃ (Quotient s → β) where
  toFun f := Quotient.lift f.1 (fun a b h => f.2 a b h)
  invFun g := ⟨fun a => g (Quotient.mk s a), fun a b h =>
    congrArg g (Quotient.sound h)⟩
  left_inv f := by
    apply Subtype.ext
    rfl
  right_inv g := by
    funext x
    exact Quotient.inductionOn x (fun a => rfl)

/-- The exact power appearing when Gaussian covariance deltas are summed. -/
theorem card_constantAssignments [Finite α] (s : Setoid α) (n : ℕ) :
    Nat.card (ConstantAssignments s (Fin n)) = n ^ classCount s := by
  classical
  letI := Fintype.ofFinite (Quotient s)
  rw [Nat.card_congr (constantAssignmentsEquiv s (Fin n))]
  simp [classCount, Nat.card_eq_fintype_card]

/-- Imposing both families of equalities is precisely imposing their join. -/
theorem constant_on_join_iff (s t : Setoid α) (β : Type*) (f : α → β) :
    (∀ a b, (s ⊔ t) a b → f a = f b) ↔
      (∀ a b, s a b → f a = f b) ∧ (∀ a b, t a b → f a = f b) := by
  change (s ⊔ t ≤ Setoid.ker f) ↔
    (s ≤ Setoid.ker f) ∧ (t ≤ Setoid.ker f)
  exact sup_le_iff

/-- Two independent Gaussian factors impose joined index equivalences.
The enlarged one-factor sample count q dominates the resulting index count. -/
theorem join_dimension_bound [Finite α] (s t : Setoid α)
    {n q : ℕ} (hq : 1 ≤ q) (hn : n ≤ q ^ 2) :
    n ^ classCount (s ⊔ t) ≤ q ^ (classCount s + classCount t) := by
  have hs : classCount (s ⊔ t) ≤ classCount s := classCount_antitone le_sup_left
  have ht : classCount (s ⊔ t) ≤ classCount t := classCount_antitone le_sup_right
  calc
    n ^ classCount (s ⊔ t) ≤ (q ^ 2) ^ classCount (s ⊔ t) :=
      Nat.pow_le_pow_left hn _
    _ = q ^ (2 * classCount (s ⊔ t)) := by rw [pow_mul]
    _ ≤ q ^ (classCount s + classCount t) :=
      Nat.pow_le_pow_right hq (by omega)

/-- Finite Wick sums for a two-factor real Gaussian covariance are bounded by
the square of the one-factor Wick sum at q columns, whenever n ≤ q².
The row-loop counts are arbitrary; only the actual column partitions matter. -/
theorem tensor_wick_sum_le_square {ι : Type*} [Fintype ι] [Finite α]
    (columnRelation : ι → Setoid α) (rowLoops : ι → ℕ)
    {n q h : ℕ} (hq : 1 ≤ q) (hn : n ≤ q ^ 2) :
    (∑ i : ι, ∑ j : ι,
      n ^ classCount (columnRelation i ⊔ columnRelation j) *
        h ^ (rowLoops i + rowLoops j)) ≤
    (∑ i : ι, q ^ classCount (columnRelation i) * h ^ rowLoops i) ^ 2 := by
  calc
    _ ≤ ∑ i : ι, ∑ j : ι,
        q ^ (classCount (columnRelation i) + classCount (columnRelation j)) *
          h ^ (rowLoops i + rowLoops j) := by
      apply Finset.sum_le_sum
      intro i hi
      apply Finset.sum_le_sum
      intro j hj
      exact Nat.mul_le_mul_right _ (join_dimension_bound _ _ hq hn)
    _ = (∑ i : ι, q ^ classCount (columnRelation i) * h ^ rowLoops i) ^ 2 := by
      simp_rw [pow_add]
      rw [pow_two, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      ring

/-- Equivalence relation generated by paired endpoint labels. This definition
works for any endpoint map; a Wick pairing will be a fixed-point-free involution. -/
def endpointRelation {E : Type*} (pair : E → E) (label : E → α) : Setoid α :=
  Relation.EqvGen.setoid (fun a b => ∃ e, label e = a ∧ label (pair e) = b)

/-- The generated quotient records exactly the endpoint equalities, with no
extra condition that distinct classes receive distinct labels. -/
theorem constant_on_endpointRelation_iff {E β : Type*}
    (pair : E → E) (label : E → α) (f : α → β) :
    (∀ a b, endpointRelation pair label a b → f a = f b) ↔
      (∀ e, f (label e) = f (label (pair e))) := by
  constructor
  · intro hf e
    exact hf _ _ (Relation.EqvGen.rel _ _ ⟨e, rfl, rfl⟩)
  · intro hf a b hab
    induction hab with
    | rel a b h =>
      rcases h with ⟨e, rfl, rfl⟩
      exact hf e
    | refl a => rfl
    | symm a b h ih => exact ih.symm
    | trans a b c hab hbc ihab ihbc => exact ihab.trans ihbc

/-- Exact cardinality of assignments satisfying a list of endpoint equalities. -/
theorem card_endpointAssignments {E : Type*} [Finite α]
    (pair : E → E) (label : E → α) (n : ℕ) :
    Nat.card {f : α → Fin n // ∀ e, f (label e) = f (label (pair e))} =
      n ^ classCount (endpointRelation pair label) := by
  let e : {f : α → Fin n // ∀ e, f (label e) = f (label (pair e))} ≃
      ConstantAssignments (endpointRelation pair label) (Fin n) :=
    { toFun := fun f => ⟨f.1,
        (constant_on_endpointRelation_iff pair label f.1).2 f.2⟩
      invFun := fun f => ⟨f.1,
        (constant_on_endpointRelation_iff pair label f.1).1 f.2⟩
      left_inv := fun f => rfl
      right_inv := fun f => rfl }
  rw [Nat.card_congr e, card_constantAssignments]

/-- Exact cardinality for the two independent factors in the Wick expansion. -/
theorem card_joint_endpointAssignments {E : Type*} [Finite α]
    (pair₁ pair₂ : E → E) (label : E → α) (n : ℕ) :
    Nat.card {f : α → Fin n //
      (∀ e, f (label e) = f (label (pair₁ e))) ∧
      (∀ e, f (label e) = f (label (pair₂ e)))} =
      n ^ classCount (endpointRelation pair₁ label ⊔ endpointRelation pair₂ label) := by
  let s := endpointRelation pair₁ label
  let t := endpointRelation pair₂ label
  have heq (f : α → Fin n) :
      ((∀ e, f (label e) = f (label (pair₁ e))) ∧
       (∀ e, f (label e) = f (label (pair₂ e)))) ↔
      (∀ a b, (s ⊔ t) a b → f a = f b) := by
    exact (and_congr (constant_on_endpointRelation_iff pair₁ label f).symm
      (constant_on_endpointRelation_iff pair₂ label f).symm).trans
      (constant_on_join_iff s t (Fin n) f).symm
  let e : {f : α → Fin n //
      (∀ e, f (label e) = f (label (pair₁ e))) ∧
      (∀ e, f (label e) = f (label (pair₂ e)))} ≃
      ConstantAssignments (s ⊔ t) (Fin n) :=
    { toFun := fun f => ⟨f.1, (heq f.1).1 f.2⟩
      invFun := fun f => ⟨f.1, (heq f.1).2 f.2⟩
      left_inv := fun f => rfl
      right_inv := fun f => rfl }
  rw [Nat.card_congr e, card_constantAssignments]

#print axioms card_endpointAssignments
#print axioms card_joint_endpointAssignments
#print axioms classCount_antitone
#print axioms card_constantAssignments
#print axioms constant_on_join_iff
#print axioms tensor_wick_sum_le_square

end GaussianTensorMoments
