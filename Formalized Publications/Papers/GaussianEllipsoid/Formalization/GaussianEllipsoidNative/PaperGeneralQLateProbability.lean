/-- On every actual real-q base bin, restriction of V is exactly u_S,
the source restriction of the original vector u. -/
theorem real_base_restriction_retained {n : ℕ}
    (q : ℝ) (u : Fin n → ℝ) (amp : ℝ) (groups : List (List ℕ)) (T : ℕ) (hT : 0 < T)
    (hreg : ∀ g∈groups,RealRegularRetainedGroup q u amp T g)
    (r : ℕ) (hr : r < groups.length) :
    let S := dyadicBin u amp ((groups[r]?.getD []).headD 0)
    GaussianEllipsoid.Dyadic.restrict (retainedGroupVector u amp groups T) S=
      GaussianEllipsoid.Dyadic.restrict u S := by
  funext i
  by_cases hi : i∈dyadicBin u amp ((groups[r]?.getD []).headD 0)
  · simp only [GaussianEllipsoid.Dyadic.restrict,if_pos hi]
    exact if_pos (real_base_bin_subset_retained q u amp groups T hT hreg r hr hi)
  · simp only [GaussianEllipsoid.Dyadic.restrict,if_neg hi]

/-- Source-specific center bridge: the actual center B(V-u_S), using the
original-vector base-bin restriction u_S, is outside-sigma-field measurable. -/
theorem real_base_actual_center_measurable {n d : ℕ}
    (q : ℝ) (u : Fin n → ℝ) (amp : ℝ) (groups : List (List ℕ)) (T : ℕ) (hT : 0 < T)
    (hreg : ∀ g∈groups,RealRegularRetainedGroup q u amp T g)
    (r : ℕ) (hr : r < groups.length) (hd : 0 < d/2) :
    let S := dyadicBin u amp ((groups[r]?.getD []).headD 0)
    Measurable[outsideSampleSigmaField (S.orderEmbOfFin rfl).toEmbedding]
      (fun z => gaussianBilinearOperator n (d/2) d z
        ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (retainedGroupVector u amp groups T)-
         (MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (GaussianEllipsoid.Dyadic.restrict u S))) := by
  let S := dyadicBin u amp ((groups[r]?.getD []).headD 0)
  let e := (S.orderEmbOfFin rfl).toEmbedding
  let v := (MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (retainedGroupVector u amp groups T)
  have heq : lateRestriction e v=
      (MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (GaussianEllipsoid.Dyadic.restrict u S) := by
    rw [lateRestriction_orderEmb,real_base_restriction_retained q u amp groups T hT hreg r hr]
  have hm := measurable_late_actual_center d hd e v
  rw [heq] at hm
  exact hm

/-- Macroscopic specialization of the source conditional estimate.
The proof retains K_+=max(K,1), so no K≥1 assumption is hidden. -/
theorem paper_macroscopic_full_array_conditional {n d : ℕ}
    (S : Finset (Fin n)) (w : Fin n → ℝ) {c₀ K ell : ℝ}
    (hc₀ : 0 < c₀) (hlarge : 64 ≤ min c₀ 1*(d:ℝ))
    (hlow : c₀*(d:ℝ) ≤ S.card) (hup : (S.card:ℝ) ≤ K*(d:ℝ))
    (hlower : ∀ i∈S,ell ≤ |w i|) (hupper : ∀ i∈S,|w i| ≤ 2*ell) :
    (tensorGaussianLaw n (d/2))[({z | spectralNuclearNorm
      (gaussianBilinearOperator n (d/2) d z ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w)) < 
      (1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d*(∑ i∈S,|w i|)}).indicator
      (1 : (GaussianEntries n (d/2) × GaussianEntries n (d/2)) → ℝ) |
      outsideSampleSigmaField (S.orderEmbOfFin rfl).toEmbedding] ≤ᵐ[tensorGaussianLaw n (d/2)]
      fun _ => Real.exp (-(1/1048576:ℝ)*min c₀ 1*(d:ℝ)^2) := by
  let e : Fin S.card ↪ Fin n := (S.orderEmbOfFin rfl).toEmbedding
  have he (i : Fin S.card) : e i∈S := S.orderEmbOfFin_mem rfl i
  have hmass : (∑ i : Fin S.card,|w (e i)|)=∑ i∈S,|w i| := by
    conv_rhs => rw [← S.map_orderEmbOfFin_univ rfl]
    simp only [sum_map,e]
  have hd0 : (0:ℝ) ≤ d := by positivity
  have hmin : min c₀ 1*(d:ℝ) ≤ (min S.card d:ℕ) := by
    rw [Nat.cast_min]
    exact le_min ((mul_le_mul_of_nonneg_right (min_le_left c₀ 1) hd0).trans hlow)
      (by nlinarith [mul_le_mul_of_nonneg_right (min_le_right c₀ 1) hd0])
  have hm : 64 ≤ min S.card d := by exact_mod_cast hlarge.trans hmin
  have hs : (0:ℝ) < S.card := by exact_mod_cast (show 0 < S.card by omega)
  have hK : (0:ℝ) < max K 1 := lt_of_lt_of_le (by norm_num) (le_max_right K 1)
  have hsm : (S.card:ℝ) ≤ max K 1*(min S.card d:ℕ) := by
    rcases le_total S.card d with hsd|hds
    · rw [min_eq_left hsd]
      nlinarith [le_max_right K 1]
    · rw [min_eq_right hds]
      exact hup.trans (mul_le_mul_of_nonneg_right (le_max_left K 1) hd0)
  have hratio : 1/max K 1 ≤ (min S.card d:ℕ)/(S.card:ℝ) := by
    rw [div_le_div_iff₀ hK hs]
    simpa [mul_comm] using hsm
  have hroot := Real.sqrt_le_sqrt hratio
  rw [Real.sqrt_div (by norm_num : (0:ℝ) ≤ 1),Real.sqrt_one] at hroot
  have hthreshold : (1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d*(∑ i∈S,|w i|) ≤ (1/1048576:ℝ)*Real.sqrt d*(∑ i∈S,|w i|)*Real.sqrt ((min S.card d:ℕ)/(S.card:ℝ)) := by
    calc
      _ = ((1/1048576:ℝ)*Real.sqrt d*(∑ i∈S,|w i|))*(1/Real.sqrt (max K 1)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hroot (by positivity)
  have hp := late_full_array_conditional e hm
    ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w) ell
    (fun i => hlower (e i) (he i)) (fun i => hupper (e i) (he i))
  have hmassV : (∑ i,|((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w) (e i)|)=
      ∑ i∈S,|w i| := hmass
  rw [hmassV] at hp
  have hmB := (continuous_spectralNuclear _ _).measurable.comp
    (measurable_full_bilinear d (by omega : 0 < d/2)
      ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w))
  have hc := conditional_indicator_mono_constant (tensorGaussianLaw n (d/2))
    (outsideSampleSigmaField e) _ _ (measurableSet_lt hmB measurable_const)
    (measurableSet_lt hmB measurable_const)
    (fun z hz => lt_of_lt_of_le hz hthreshold) _ hp
  have hrate : Real.exp (-(1/1048576:ℝ)*(d:ℝ)*(min S.card d:ℕ)) ≤ Real.exp (-(1/1048576:ℝ)*min c₀ 1*(d:ℝ)^2) := by
    apply Real.exp_le_exp.mpr
    have hh := mul_le_mul_of_nonneg_left hmin hd0
    nlinarith
  exact hc.trans (Filter.Eventually.of_forall (fun _ => hrate))

/-- Unconditional macroscopic specialization, explicitly using tower integration. -/
theorem paper_macroscopic_full_array_probability {n d : ℕ}
    (S : Finset (Fin n)) (w : Fin n → ℝ) {c₀ K ell : ℝ}
    (hc₀ : 0 < c₀) (hlarge : 64 ≤ min c₀ 1*(d:ℝ))
    (hlow : c₀*(d:ℝ) ≤ S.card) (hup : (S.card:ℝ) ≤ K*(d:ℝ))
    (hlower : ∀ i∈S,ell ≤ |w i|) (hupper : ∀ i∈S,|w i| ≤ 2*ell) :
    (tensorGaussianLaw n (d/2)).real {z | spectralNuclearNorm
      (gaussianBilinearOperator n (d/2) d z ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w)) < 
      (1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d*(∑ i∈S,|w i|)} ≤ Real.exp (-(1/1048576:ℝ)*min c₀ 1*(d:ℝ)^2) := by
  have hp := paper_macroscopic_full_array_conditional S w hc₀ hlarge hlow hup hlower hupper
  apply probability_le_of_conditional_indicator _
    (outsideSampleSigmaField (S.orderEmbOfFin rfl).toEmbedding)
    (outsideSampleSigmaField_le _) _ ?_ _ hp
  have hdcast : (64:ℝ) ≤ d := by
    have hh := mul_le_mul_of_nonneg_right (min_le_right c₀ 1) (Nat.cast_nonneg d)
    nlinarith
  have hd : 64 ≤ d := by exact_mod_cast hdcast
  exact measurableSet_lt ((continuous_spectralNuclear _ _).measurable.comp
    (measurable_full_bilinear (h := d/2) d (by omega) ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w)))
    measurable_const

/-- Arbitrary-real-q conditional late branch on the actual retained vector.
The sigma-field reveals all samples outside the selected actual base dyadic bin.
Every displayed coefficient, mass, support and normalization is literal. -/
theorem real_retained_late_conditional {n d : ℕ}
    (q : ℝ) (hq : 1 < q) (u : Fin n → ℝ) (amp : ℝ) (ha : 0 < amp)
    (groups : List (List ℕ)) (T : ℕ) (hT : 0 < T)
    (hreg : ∀ g∈groups,RealRegularRetainedGroup q u amp T g)
    (hchain : groups.IsChain (GaussianEllipsoid.PaperRealRecord.RecordSuccessor q
      fun t => ((dyadicBin u amp t).card:ℝ)))
    (hflat : groups.flatten.Nodup) (rho K J : ℝ) (hrho : 0 < rho) (hJ : 0 < J)
    (hlarge : 64 ≤ min (rho*(q-1)/((T:ℝ)*q^2)) 1*(d:ℝ))
    (hsupp : ((univ.filter fun i => u i≠0).card:ℝ) ≤ K*d)
    (b : ℕ) (hb : SupportCutoff (dyadicGroupSize u amp groups T) groups.length (rho*d) b)
    (hcount : ((groups.length-b:ℕ):ℝ) ≤ J)
    (hM : 0 < coefficientMass (retainedGroupVector u amp groups T))
    (hcapt : (∑ r∈range b,dyadicGroupMass u amp groups T r) < 
      coefficientMass (retainedGroupVector u amp groups T)/2) :
    ∃ r : ℕ,b ≤ r ∧ r < groups.length ∧
      let S := dyadicBin u amp ((groups[r]?.getD []).headD 0)
      (tensorGaussianLaw n (d/2))[({z | spectralNuclearNorm
      (gaussianBilinearOperator n (d/2) d z
        ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (retainedGroupVector u amp groups T))) < 
      (1/1048576:ℝ)/(8*q*Real.sqrt (max K 1)*J)*Real.sqrt d*
        coefficientMass (retainedGroupVector u amp groups T)}).indicator
        (1 : (GaussianEntries n (d/2) × GaussianEntries n (d/2)) → ℝ) |
        outsideSampleSigmaField (S.orderEmbOfFin rfl).toEmbedding] ≤ᵐ[tensorGaussianLaw n (d/2)]
      fun _ => Real.exp (-(1/1048576:ℝ)*min (rho*(q-1)/((T:ℝ)*q^2)) 1*(d:ℝ)^2) := by
  obtain ⟨r,hbr,hr,ha',hmass,hsize,hup,hwindow,hweq⟩ :=
    real_late_driver_selection q hq u amp ha groups T hT hreg hchain hflat
      rho K d J hrho hJ hsupp b hb hcount hM hcapt
  let I := dyadicBin u amp ((groups[r]?.getD []).headD 0)
  let a := amp*(1/2:ℝ)^((groups[r]?.getD []).headD 0+1)
  let w := retainedGroupVector u amp groups T
  have hwu : ∀ i∈I,w i=u i := fun i hi => hweq i hi
  have hc0 : 0 < rho*(q-1)/((T:ℝ)*q^2) := by
    have hT' : (0:ℝ) < T := by exact_mod_cast hT
    have hq' : 0 < q := by linarith
    have hqm : 0 < q-1 := by linarith
    positivity
  have hmass' : coefficientMass w/(8*q*J) ≤ ∑ i∈I,|w i| := by
    calc
      _ ≤ ∑ i∈I,|u i| := hmass
      _ = _ := Finset.sum_congr rfl (fun i hi => by rw [hwu i hi])
  have hp := paper_macroscopic_full_array_conditional I w (ell := a) hc0 hlarge hsize.le hup
    (fun i hi => by rw [hwu i hi]; exact (hwindow i hi).1.le)
    (fun i hi => by rw [hwu i hi]; exact (hwindow i hi).2)
  have hk : 0 < Real.sqrt (max K 1) := Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one (le_max_right K 1))
  have hthreshold : (1/1048576:ℝ)/(8*q*Real.sqrt (max K 1)*J)*Real.sqrt d*coefficientMass w ≤ (1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d*(∑ i∈I,|w i|) := by
    have hh := mul_le_mul_of_nonneg_left hmass'
      (show 0 ≤ (1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d by positivity)
    calc
      _ = ((1/1048576:ℝ)/Real.sqrt (max K 1)*Real.sqrt d)*
          (coefficientMass w/(8*q*J)) := by
        field_simp [hk.ne',hJ.ne',ne_of_gt (lt_trans zero_lt_one hq)]
        <;> ring
      _ ≤ _ := hh
  refine ⟨r,hbr,hr,?_⟩
  have hdcast : (64:ℝ) ≤ d := by
    have hh := mul_le_mul_of_nonneg_right
      (min_le_right (rho*(q-1)/((T:ℝ)*q^2)) 1) (Nat.cast_nonneg d)
    nlinarith
  have hd : 64 ≤ d := by exact_mod_cast hdcast
  have hmB := (continuous_spectralNuclear _ _).measurable.comp
    (measurable_full_bilinear d (by omega : 0 < d/2)
      ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w))
  exact conditional_indicator_mono_constant (tensorGaussianLaw n (d/2))
    (outsideSampleSigmaField (I.orderEmbOfFin rfl).toEmbedding) _ _
    (measurableSet_lt hmB measurable_const) (measurableSet_lt hmB measurable_const)
    (fun z hz => lt_of_lt_of_le hz hthreshold) _ hp

/-- Unconditional actual retained late branch, obtained from the checked source conditional. -/
theorem real_retained_late_smallball {n d : ℕ}
    (q : ℝ) (hq : 1 < q) (u : Fin n → ℝ) (amp : ℝ) (ha : 0 < amp)
    (groups : List (List ℕ)) (T : ℕ) (hT : 0 < T)
    (hreg : ∀ g∈groups,RealRegularRetainedGroup q u amp T g)
    (hchain : groups.IsChain (GaussianEllipsoid.PaperRealRecord.RecordSuccessor q
      fun t => ((dyadicBin u amp t).card:ℝ)))
    (hflat : groups.flatten.Nodup) (rho K J : ℝ) (hrho : 0 < rho) (hJ : 0 < J)
    (hlarge : 64 ≤ min (rho*(q-1)/((T:ℝ)*q^2)) 1*(d:ℝ))
    (hsupp : ((univ.filter fun i => u i≠0).card:ℝ) ≤ K*d)
    (b : ℕ) (hb : SupportCutoff (dyadicGroupSize u amp groups T) groups.length (rho*d) b)
    (hcount : ((groups.length-b:ℕ):ℝ) ≤ J)
    (hM : 0 < coefficientMass (retainedGroupVector u amp groups T))
    (hcapt : (∑ r∈range b,dyadicGroupMass u amp groups T r) < 
      coefficientMass (retainedGroupVector u amp groups T)/2) :
    (tensorGaussianLaw n (d/2)).real {z | spectralNuclearNorm
      (gaussianBilinearOperator n (d/2) d z
        ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (retainedGroupVector u amp groups T))) < 
      (1/1048576:ℝ)/(8*q*Real.sqrt (max K 1)*J)*Real.sqrt d*
        coefficientMass (retainedGroupVector u amp groups T)} ≤ Real.exp (-(1/1048576:ℝ)*min (rho*(q-1)/((T:ℝ)*q^2)) 1*(d:ℝ)^2) := by
  obtain ⟨r,hbr,hr,hcond⟩ := real_retained_late_conditional q hq u amp ha groups T hT
    hreg hchain hflat rho K J hrho hJ hlarge hsupp b hb hcount hM hcapt
  apply probability_le_of_conditional_indicator _
    (outsideSampleSigmaField ((dyadicBin u amp ((groups[r]?.getD []).headD 0)).orderEmbOfFin rfl).toEmbedding)
    (outsideSampleSigmaField_le _) _ ?_ _ hcond
  have hdcast : (64:ℝ) ≤ d := by
    have hh := mul_le_mul_of_nonneg_right
      (min_le_right (rho*(q-1)/((T:ℝ)*q^2)) 1) (Nat.cast_nonneg d)
    nlinarith
  have hd : 64 ≤ d := by exact_mod_cast hdcast
  exact measurableSet_lt ((continuous_spectralNuclear _ _).measurable.comp
    (measurable_full_bilinear (h := d/2) d (by omega)
      ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) (retainedGroupVector u amp groups T))))
    measurable_const

/-- Uniform logarithmic budget positivity before any dimension, vector or
late-branch choice. This supplies a parameter-only c_ret in the final assembly. -/
theorem real_late_log_budget_one_le (q rho K : ℝ) (T : ℕ)
    (hq : 1 < q) (hT : 0 < T) (hrho : 0 < rho) (hrhocap : rho < 1/8) :
    1 ≤ 1+Real.log ((q^2/(q-1))*max K 1*T/rho)/Real.log q := by
  have hqm : 0 < q-1 := by linarith
  have hT' : (1:ℝ) ≤ T := by exact_mod_cast hT
  have hK : (1:ℝ) ≤ max K 1 := le_max_right K 1
  have hbase : 1 ≤ q^2/(q-1) := by
    apply (le_div_iff₀ hqm).mpr
    nlinarith [sq_nonneg (q-1)]
  have hKT : (1:ℝ) ≤ max K 1*T := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hK) (sub_nonneg.mpr hT')]
  have hnum : (1:ℝ) ≤ (q^2/(q-1))*max K 1*T := by
    calc
      _ ≤ 1*(max K 1*T) := by simpa using hKT
      _ ≤ (q^2/(q-1))*(max K 1*T) :=
        mul_le_mul_of_nonneg_right hbase (by positivity)
      _ = _ := by ring
  have harg : (1:ℝ) ≤ (q^2/(q-1))*max K 1*T/rho := by
    apply (le_div_iff₀ hrho).mpr
    linarith
  have hlog := div_nonneg (Real.log_nonneg harg) (Real.log_pos hq).le
  linarith

/-- Exact source logarithmic late count with K_+, positive in the late branch.
This is derived from the actual cutoff and original support, rather than assumed. -/
theorem real_late_logarithmic_budget {ι : Type*} [Fintype ι]
    (q : ℝ) (hq : 1 < q) (u : ι → ℝ) (amp : ℝ) (ha : 0 < amp)
    (groups : List (List ℕ)) (T : ℕ) (hT : 0 < T)
    (hreg : ∀ g∈groups,RealRegularRetainedGroup q u amp T g)
    (hchain : groups.IsChain (GaussianEllipsoid.PaperRealRecord.RecordSuccessor q
      fun t => ((dyadicBin u amp t).card:ℝ)))
    (hflat : groups.flatten.Nodup) (rho K d : ℝ) (hrho : 0 < rho) (hd : 0 < d)
    (hsupp : ((univ.filter fun i => u i≠0).card:ℝ) ≤ K*d)
    (b : ℕ) (hb : SupportCutoff (dyadicGroupSize u amp groups T) groups.length (rho*d) b)
    (hcapt : (∑ r∈range b,dyadicGroupMass u amp groups T r) < 
      coefficientMass (retainedGroupVector u amp groups T)/2) :
    0 < 1+Real.log ((q^2/(q-1))*max K 1*T/rho)/Real.log q ∧
    ((groups.length-b:ℕ):ℝ) ≤ 1+Real.log ((q^2/(q-1))*max K 1*T/rho)/Real.log q := by
  have hbn := real_late_branch_nonempty q u amp ha.le groups T b hb.1 hreg hflat hcapt
  have hc := paper_real_rho_late_count q hq u amp ha groups T hT hreg hchain
    rho (max K 1) d hrho (lt_of_lt_of_le zero_lt_one (le_max_right K 1)) hd
    (hsupp.trans (mul_le_mul_of_nonneg_right (le_max_left K 1) hd.le)) b hb hbn
  refine ⟨lt_of_lt_of_le ?_ hc,hc⟩
  exact_mod_cast (Nat.sub_pos_of_lt hbn)

/-- Exact transport of the strict nuclear sublevel from full-array samples to
canonical Gaussian pair rows; the d^(-1/2) scaling is unchanged. -/
theorem paper_strict_canonical_probability (n h d : ℕ) (w : Fin n → ℝ) (a : ℝ) :
    (gaussianBilinearSampleLaw (Fin n) h h).real
      {X | spectralNuclearNorm (operatorFrobenius
        ((Real.sqrt (d:ℝ))⁻¹ • bilinearSynthesis w X)) < a} =
    (tensorGaussianLaw n h).real {z | spectralNuclearNorm
      (gaussianBilinearOperator n h d z ((MeasurableEquiv.toLp 2 ((Fin n) → ℝ)) w)) < a} := by
  have hE : MeasurableSet {X : Fin n → Euclid h × Euclid h |
      spectralNuclearNorm (operatorFrobenius ((Real.sqrt (d:ℝ))⁻¹ • bilinearSynthesis w X)) < a} :=
    measurableSet_lt (measurable_scaled_bilinear_nuclear (d:=d) w) measurable_const
  rw [← (tensorToCanonicalRows_preserving n h).measureReal_preimage hE.nullMeasurableSet]
  congr 1
  ext z
  simp only [Set.mem_preimage,Set.mem_setOf_eq,scaled_bilinearSynthesis_tensorToCanonicalRows]

/-- The source's starting dimension is selected before all sample sizes,
coefficient vectors, actual group decompositions and late-bin choices. -/
theorem real_late_dimension_threshold (q rho : ℝ) (T : ℕ)
    (hq : 1 < q) (hrho : 0 < rho) (hT : 0 < T) :
    ∃ d₀ : ℕ,∀ d : ℕ,d₀ ≤ d →
      64 ≤ min (rho*(q-1)/((T:ℝ)*q^2)) 1*(d:ℝ) := by
  let c₀ := rho*(q-1)/((T:ℝ)*q^2)
  have hc₀ : 0 < c₀ := by
    have hT' : (0:ℝ) < T := by exact_mod_cast hT
    have hq' : 0 < q := by linarith
    have hqm : 0 < q-1 := by linarith
    dsimp [c₀]
    positivity
  have hmin : 0 < min c₀ 1 := lt_min hc₀ zero_lt_one
  obtain ⟨d₀,hd₀⟩ := exists_nat_ge (64/min c₀ 1)
  refine ⟨d₀,?_⟩
  intro d hd
  have hh := (div_le_iff₀ hmin).mp (hd₀.trans (Nat.cast_le.mpr hd))
  simpa only [mul_comm] using hh

