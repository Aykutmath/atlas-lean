/-- Literal restriction of the original coefficient vector to the chosen sample indices. -/
def lateRestriction {N s : ℕ} (e : Fin s ↪ Fin N) (v : Euclid N) : Euclid N :=
  (MeasurableEquiv.toLp 2 ((Fin N) → ℝ))
    (fun i => if i ∈ Set.range e then v i else 0)

@[simp] theorem lateRestriction_selected {N s : ℕ} (e : Fin s ↪ Fin N)
    (v : Euclid N) (i : Fin s) : lateRestriction e v (e i)=v (e i) := by
  change (if e i ∈ Set.range e then v (e i) else 0)=v (e i)
  simp

theorem lateRestriction_zero_outside {N s : ℕ} (e : Fin s ↪ Fin N)
    (v : Euclid N) (i : Fin N) (hi : i ∉ Set.range e) : lateRestriction e v i=0 := by
  change (if i ∈ Set.range e then v i else 0)=0
  simp [hi]

/-- Increasing enumeration restricts to exactly S, with no reordering of the
coefficient vector or widening of the driver support. -/
theorem lateRestriction_orderEmb {N : ℕ} (S : Finset (Fin N)) (w : Fin N → ℝ) :
    lateRestriction (S.orderEmbOfFin rfl).toEmbedding
      ((MeasurableEquiv.toLp 2 ((Fin N) → ℝ)) w) =
      (MeasurableEquiv.toLp 2 ((Fin N) → ℝ)) (GaussianEllipsoid.Dyadic.restrict w S) := by
  ext i
  change (if i ∈ Set.range (S.orderEmbOfFin rfl) then w i else 0)=
    (if i ∈ S then w i else 0)
  simp only [S.range_orderEmbOfFin rfl,Finset.mem_coe]

/-- Restriction mass equals the sum of the selected original coefficients. -/
theorem lateRestriction_mass {N s : ℕ} (e : Fin s ↪ Fin N) (v : Euclid N) :
    (∑ i,|lateRestriction e v i|)=∑ i,|v (e i)| := by
  have hh := sum_abs_euclideanCoordinateSubfamily e (lateRestriction e v)
    (lateRestriction_zero_outside e v)
  simpa only [euclideanCoordinateSubfamily_apply,lateRestriction_selected] using hh.symm

/-- Literal flat-coordinate and full-array observables have identical normalization. -/
theorem flatBilinear_eq_full {N h : ℕ} (d : ℕ) (hh : 0 < h)
    (v : Euclid N) (z : GaussianEntries N h × GaussianEntries N h) :
    flatBilinear (d:ℝ) h N (fun i => v i) z=gaussianBilinearOperator N h d z v :=
  bilinearScaled_flatToSmallBall N h d hh z v

theorem measurable_full_bilinear {N h : ℕ} (d : ℕ) (hh : 0 < h) (v : Euclid N) :
    Measurable (fun z => gaussianBilinearOperator N h d z v) := by
  have hm := measurable_flatBilinear (d:ℝ) h N (fun i => v i)
  change Measurable (fun z => flatBilinear (d:ℝ) h N (fun i => v i) z) at hm
  simpa only [flatBilinear_eq_full d hh v] using hm

/-- The actual center B(V-u_S) is measurable in the sigma-field generated by
all and only outside sample coordinates; no center-measurability premise is assumed. -/
theorem measurable_late_actual_center {N s h : ℕ} (d : ℕ) (hh : 0 < h)
    (e : Fin s ↪ Fin N) (v : Euclid N) :
    Measurable[outsideSampleSigmaField e]
      (fun z => gaussianBilinearOperator N h d z (v-lateRestriction e v)) := by
  let eO := outsideSampleEmbedding e
  have hz : ∀ i ∉ Set.range eO,(v-lateRestriction e v) i=0 := by
    intro i hi
    have hiS : i ∈ Set.range e := by
      simpa only [eO,outsideSampleEmbedding_range,Set.mem_compl_iff,not_not] using hi
    change v i-(if i ∈ Set.range e then v i else 0)=0
    simp [hiS]
  have hm := (measurable_full_bilinear d hh
    (euclideanCoordinateSubfamily eO (v-lateRestriction e v))).comp
      (measurable_selectSample_own_sigma (h:=h) eO)
  have he : (fun z => gaussianBilinearOperator _ h d (selectSample eO z)
      (euclideanCoordinateSubfamily eO (v-lateRestriction e v))) =
      (fun z => gaussianBilinearOperator N h d z (v-lateRestriction e v)) := by
    funext z
    exact gaussianBilinearOperator_selectSample d eO z _ hz
  simp only [Function.comp_def] at hm
  rw [he] at hm
  exact hm

/-- Exact full-array identity of the source shifted observable and B(V). -/
theorem late_actual_center_add_driver {N s h : ℕ} (d : ℕ) (hh : 0 < h)
    (e : Fin s ↪ Fin N) (v : Euclid N)
    (z : GaussianEntries N h × GaussianEntries N h) :
    gaussianBilinearOperator N h d z (v-lateRestriction e v)+
      flatBilinear (d:ℝ) h s (fun i => v (e i)) (selectSample e z)=
      gaussianBilinearOperator N h d z v := by
  have hc : (fun i => v (e i)) =
      (fun i => euclideanCoordinateSubfamily e (lateRestriction e v) i) := by
    funext i
    exact (lateRestriction_selected e v i).symm
  rw [hc,flatBilinear_eq_full d hh,
    gaussianBilinearOperator_selectSample d e z _ (lateRestriction_zero_outside e v)]
  rw [map_sub,sub_add_cancel]

/-- Checked shifted conditional estimate on the literal original full Gaussian
array, after constructing and proving the measurability of its actual center. -/
theorem late_full_array_conditional {N s d : ℕ} (e : Fin s ↪ Fin N)
    (hmin : 64 ≤ min s d) (v : Euclid N) (ell : ℝ)
    (hlower : ∀ i,ell ≤ |v (e i)|) (hupper : ∀ i,|v (e i)| ≤ 2*ell) :
    (tensorGaussianLaw N (d/2))[({z | spectralNuclearNorm
      (gaussianBilinearOperator N (d/2) d z v) < 
      (1/1048576:ℝ)*Real.sqrt d*(∑ i,|v (e i)|)*
        Real.sqrt ((min s d:ℕ)/(s:ℝ))}).indicator
      (1 : (GaussianEntries N (d/2) × GaussianEntries N (d/2)) → ℝ) |
        outsideSampleSigmaField e] ≤ᵐ[tensorGaussianLaw N (d/2)]
      fun _ => Real.exp (-(1/1048576:ℝ)*(d:ℝ)*(min s d:ℕ)) := by
  have hh : 0 < d/2 := by omega
  have hp := late_driver_outside_half_dimension_conditional e hmin
    (fun _ => fun i => v (e i))
    (fun z => gaussianBilinearOperator N (d/2) d z (v-lateRestriction e v))
    measurable_const (measurable_late_actual_center d hh e v)
    (Filter.Eventually.of_forall (fun _ => ⟨ell,hlower,hupper⟩))
  simpa only [late_actual_center_add_driver d hh] using hp

/-- Monotonicity for genuine conditional probabilities of measurable events. -/
theorem conditional_indicator_mono_constant {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (m : MeasurableSpace Ω)
    (E F : Set Ω) (hE : MeasurableSet[mΩ] E) (hF : MeasurableSet[mΩ] F) (hsub : E⊆F)
    (c : ℝ) (hc : μ[F.indicator (1 : Ω → ℝ)|m] ≤ᵐ[μ] fun _ => c) :
    μ[E.indicator (1 : Ω → ℝ)|m] ≤ᵐ[μ] fun _ => c := by
  have hmono : E.indicator (1 : Ω → ℝ) ≤ᵐ[μ] F.indicator (1 : Ω → ℝ) := by
    apply Filter.Eventually.of_forall
    intro z
    by_cases hz : z∈E
    · simp [hz,hsub hz]
    · by_cases hzF : z∈F <;> simp [hz,hzF]
  exact (condExp_mono (m := m) (μ := μ) ((integrable_const (1:ℝ)).indicator hE)
    ((integrable_const (1:ℝ)).indicator hF) hmono).trans hc

/-- The unconditional bridge is obtained by integrating the actual conditional
probability, with the tower identity explicitly present in the proof. -/
theorem probability_le_of_conditional_indicator {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (m : MeasurableSpace Ω) (hm : m ≤ mΩ)
    (E : Set Ω) (hE : MeasurableSet[mΩ] E) (c : ℝ)
    (hc : μ[E.indicator (1 : Ω → ℝ)|m] ≤ᵐ[μ] fun _ => c) : μ.real E ≤ c := by
  have hi := integral_mono_ae (integrable_condExp : Integrable (μ[E.indicator (1 : Ω → ℝ)|m]) μ)
    (integrable_const c) hc
  rw [integral_condExp hm,integral_indicator_one hE] at hi
  simpa using hi

/-- Full-array probability bound, derived from the source conditional bound by integration. -/
theorem late_full_array_probability {N s d : ℕ} (e : Fin s ↪ Fin N)
    (hmin : 64 ≤ min s d) (v : Euclid N) (ell : ℝ)
    (hlower : ∀ i,ell ≤ |v (e i)|) (hupper : ∀ i,|v (e i)| ≤ 2*ell) :
    (tensorGaussianLaw N (d/2)).real {z | spectralNuclearNorm
      (gaussianBilinearOperator N (d/2) d z v) < 
      (1/1048576:ℝ)*Real.sqrt d*(∑ i,|v (e i)|)*
        Real.sqrt ((min s d:ℕ)/(s:ℝ))} ≤ Real.exp (-(1/1048576:ℝ)*(d:ℝ)*(min s d:ℕ)) := by
  apply probability_le_of_conditional_indicator _ (outsideSampleSigmaField e)
    (outsideSampleSigmaField_le e) _ ?_ _ (late_full_array_conditional e hmin v ell hlower hupper)
  exact measurableSet_lt ((continuous_spectralNuclear _ _).measurable.comp
    (measurable_full_bilinear (h := d/2) d (by omega) v)) measurable_const

