import PaperCavityConditioning

noncomputable section
open MeasureTheory ProbabilityTheory BMFiniteGibbsTest BMProductLogPartition
namespace GaussianEllipsoid.PaperCavityConditioning
variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- Literal other-row conditioning on an arbitrary underlying probability
space. The sigma-field may contain all raw other-row information; it is not
restricted to the smaller sigma-field generated by candidate measurements. -/
theorem paper_other_row_conditional_expectation {Ω : Type*}
    (m : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (hm : m ≤ mΩ)
    (D : Data κ) (n : ℕ) (i : Fin (n+1))
    (U : Ω→Fin n→κ→ℝ) (hU : Measurable[m] U)
    (X : Ω→((κ→ℝ)×(κ→ℝ))) (hX : Measurable X)
    (hind : Indep m (MeasurableSpace.comap X inferInstance) μ) :
    μ[fun ω => UCActualFreeEnergy.freeEnergy D (i.insertNth (X ω).1 (U ω))-
      UCActualFreeEnergy.freeEnergy D (i.insertNth (X ω).2 (U ω)) | m] =ᵐ[μ]
      fun ω => ∫ xy,rowDeletedDifference D (U ω) xy.1 xy.2 ∂μ.map X := by
  have hβ := D.beta_nonneg
  have he := GaussianConditionalBound.condExp_independent_bounded_kernel m μ hm
    U X hU hX hind (fun z => rowDeletedDifference D z.1 z.2.1 z.2.2)
    (rowDeletedDifference_measurable D n)
    (2*(D.beta*‖D.potential‖)/|D.beta*(n+1:ℕ)|) (by positivity)
    (fun z => rowDeletedDifference_bound D z.1 z.2.1 z.2.2)
  have hfun : (fun ω => UCActualFreeEnergy.freeEnergy D (i.insertNth (X ω).1 (U ω))-
      UCActualFreeEnergy.freeEnergy D (i.insertNth (X ω).2 (U ω))) =
      (fun ω => rowDeletedDifference D (U ω) (X ω).1 (X ω).2) := by
    funext ω
    exact rowDeletedDifference_eq D i (U ω) (X ω).1 (X ω).2
  rw [hfun]
  exact he

#print axioms paper_other_row_conditional_expectation
end GaussianEllipsoid.PaperCavityConditioning
