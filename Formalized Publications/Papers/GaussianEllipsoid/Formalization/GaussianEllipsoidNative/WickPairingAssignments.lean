import CanonicalWickPairings
import TensorWickCombinatorics
import Mathlib.Algebra.BigOperators.GroupWithZero.Finset
import Mathlib.Tactic

/-! Exact assignment-count identities for concrete Wick pairing edges. These
connect the proved Gaussian Wick expansion to the quotient-cardinality bound. -/

noncomputable section
open scoped BigOperators Classical

namespace GaussianTensorMoments

/-- Equivalence constraints on a label set generated by the paired edges. -/
def edgeRelation {E α : Type*} (p : List (E × E)) (label : E → α) : Setoid α :=
  Relation.EqvGen.setoid (fun a b => ∃ e ∈ p, label e.1=a ∧ label e.2=b)

/-- Constant assignments on the generated quotient are exactly assignments
satisfying every listed edge constraint. -/
theorem constant_on_edgeRelation_iff {E α β : Type*}
    (p : List (E × E)) (label : E → α) (f : α → β) :
    (∀ a b, edgeRelation p label a b → f a=f b) ↔
      ∀ e ∈ p, f (label e.1)=f (label e.2) := by
  constructor
  · intro hf e he
    exact hf _ _ (Relation.EqvGen.rel _ _ ⟨e, he, rfl, rfl⟩)
  · intro hf a b hab
    induction hab with
    | rel a b h =>
      rcases h with ⟨e, he, rfl, rfl⟩
      exact hf e he
    | refl a => rfl
    | symm a b h ih => exact ih.symm
    | trans a b c hab hbc ihab ihbc => exact ihab.trans ihbc

/-- A product of Kronecker deltas is the indicator of all edge equalities. -/
theorem pairingWeight_eq_indicator {E ι : Type*} [DecidableEq ι]
    (label : E → ι) (p : List (E × E)) :
    pairingWeight label p = if ∀ e ∈ p, label e.1=label e.2 then 1 else 0 := by
  induction p with
  | nil => simp
  | cons e p ih =>
    rcases e with ⟨a,b⟩
    rw [pairingWeight_cons, ih]
    by_cases hab : label a=label b <;> simp [List.mem_cons, forall_eq_or_imp, hab]

/-- The indicator expressed directly through the induced equivalence relation. -/
theorem pairingWeight_eq_quotient_indicator {E α β : Type*} [DecidableEq β]
    (p : List (E × E)) (label : E → α) (f : α → β) :
    pairingWeight (f ∘ label) p =
      if ∀ a b, edgeRelation p label a b → f a=f b then 1 else 0 := by
  rw [pairingWeight_eq_indicator, constant_on_edgeRelation_iff]
  by_cases h : ∀ e ∈ p, f (label e.1)=f (label e.2) <;> simp [Function.comp_apply, h]

/-- Summing a Wick delta weight over all assignments counts quotient classes. -/
theorem sum_pairingWeight_assignments {E α : Type*} [Fintype α] [DecidableEq α]
    (p : List (E × E)) (label : E → α) (n : ℕ) :
    (∑ f : α → Fin n, pairingWeight (f ∘ label) p) = n ^ classCount (edgeRelation p label) := by
  classical
  simp_rw [pairingWeight_eq_quotient_indicator]
  try simp only [Finset.sum_boole]
  rw [← card_constantAssignments (edgeRelation p label) n]
  simp [ConstantAssignments, Nat.card_eq_fintype_card, Fintype.card_subtype]
  convert Finset.sum_boole (R := ℕ)
    (fun f : α → Fin n => ∀ a b, edgeRelation p label a b → f a=f b) Finset.univ using 1
  · apply Finset.sum_congr rfl
    intro f _
    split_ifs <;> rfl
  · simp only [Nat.cast_id]

/-- Two Wick factors share sample assignments, so their quotient constraint is
the join of the individual column relations. -/
theorem sum_pairingWeight_mul_assignments {E α : Type*} [Fintype α] [DecidableEq α]
    (p₁ p₂ : List (E × E)) (label : E → α) (n : ℕ) :
    (∑ f : α → Fin n, pairingWeight (f ∘ label) p₁ * pairingWeight (f ∘ label) p₂) =
      n ^ classCount (edgeRelation p₁ label ⊔ edgeRelation p₂ label) := by
  classical
  have heq (f : α → Fin n) :
      pairingWeight (f ∘ label) p₁ * pairingWeight (f ∘ label) p₂ =
      if ∀ a b, (edgeRelation p₁ label ⊔ edgeRelation p₂ label) a b → f a=f b
      then 1 else 0 := by
    rw [pairingWeight_eq_quotient_indicator, pairingWeight_eq_quotient_indicator]
    have hj := constant_on_join_iff (edgeRelation p₁ label) (edgeRelation p₂ label) (Fin n) f
    by_cases h₁ : ∀ a b, edgeRelation p₁ label a b → f a=f b
    · by_cases h₂ : ∀ a b, edgeRelation p₂ label a b → f a=f b
      · simp only [if_pos h₁, if_pos h₂, if_pos (hj.mpr ⟨h₁,h₂⟩), mul_one]
      · have hn : ¬ (∀ a b, (edgeRelation p₁ label ⊔ edgeRelation p₂ label) a b → f a=f b) :=
          fun h => h₂ (hj.mp h).2
        simp [h₁,h₂,hn]
    · have hn : ¬ (∀ a b, (edgeRelation p₁ label ⊔ edgeRelation p₂ label) a b → f a=f b) :=
        fun h => h₁ (hj.mp h).1
      simp [h₁,hn]
  simp_rw [heq]
  try simp only [Finset.sum_boole]
  rw [← card_constantAssignments (edgeRelation p₁ label ⊔ edgeRelation p₂ label) n]
  simp [ConstantAssignments, Nat.card_eq_fintype_card, Fintype.card_subtype]

/-- Equality of paired Gaussian entry coordinates factors into a sample-index
constraint and an independent row-index constraint. -/
theorem pairingWeight_prod_labels {E α β : Type*} [DecidableEq α] [DecidableEq β]
    (a : E → α) (b : E → β) (p : List (E × E)) :
    pairingWeight (fun e => (a e,b e)) p = pairingWeight a p * pairingWeight b p := by
  induction p with
  | nil => simp
  | cons e p ih =>
    rcases e with ⟨x,y⟩
    simp only [pairingWeight_cons, ih, Prod.mk.injEq]
    by_cases ha : a x=a y <;> by_cases hb : b x=b y <;> simp [ha,hb]

/-- One Gaussian Wick term, summed over column and row assignments. -/
theorem sum_pairingWeight_entry_assignments {E C R : Type*}
    [Fintype C] [DecidableEq C] [Fintype R] [DecidableEq R]
    (p : List (E × E)) (c : E → C) (r : E → R) (n h : ℕ) :
    (∑ f : C → Fin n, ∑ g : R → Fin h,
      pairingWeight (fun e => (f (c e),g (r e))) p) =
      n^classCount (edgeRelation p c) * h^classCount (edgeRelation p r) := by
  simp_rw [pairingWeight_prod_labels]
  change (∑ f : C → Fin n, ∑ g : R → Fin h,
    pairingWeight (f ∘ c) p * pairingWeight (g ∘ r) p) = _
  simp_rw [← Finset.mul_sum]
  rw [← Finset.sum_mul, sum_pairingWeight_assignments, sum_pairingWeight_assignments]

/-- Two independent row families share their column assignments. This is the
exact joined-partition coefficient in the tensor moment expansion. -/
theorem sum_two_pairingWeight_entry_assignments {E C R : Type*}
    [Fintype C] [DecidableEq C] [Fintype R] [DecidableEq R]
    (p₁ p₂ : List (E × E)) (c : E → C) (r : E → R) (n h : ℕ) :
    (∑ f : C → Fin n, ∑ g : R → Fin h, ∑ k : R → Fin h,
      pairingWeight (fun e => (f (c e),g (r e))) p₁ *
        pairingWeight (fun e => (f (c e),k (r e))) p₂) =
      n^classCount (edgeRelation p₁ c ⊔ edgeRelation p₂ c) *
        h^(classCount (edgeRelation p₁ r)+classCount (edgeRelation p₂ r)) := by
  simp_rw [pairingWeight_prod_labels]
  change (∑ f : C → Fin n, ∑ g : R → Fin h, ∑ k : R → Fin h,
    (pairingWeight (f ∘ c) p₁ * pairingWeight (g ∘ r) p₁) *
      (pairingWeight (f ∘ c) p₂ * pairingWeight (k ∘ r) p₂)) = _
  calc
    _ = (∑ k : R → Fin h, pairingWeight (k ∘ r) p₂) *
        (∑ g : R → Fin h, pairingWeight (g ∘ r) p₁) *
        (∑ f : C → Fin n, pairingWeight (f ∘ c) p₁ * pairingWeight (f ∘ c) p₂) := by
      simp only [Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro f hf
      apply Finset.sum_congr rfl
      intro g hg
      apply Finset.sum_congr rfl
      intro k hk
      ring
    _ = _ := by
      rw [sum_pairingWeight_assignments, sum_pairingWeight_assignments,
        sum_pairingWeight_mul_assignments, pow_add]
      ring

#print axioms sum_two_pairingWeight_entry_assignments
#print axioms sum_pairingWeight_assignments
#print axioms sum_pairingWeight_mul_assignments
#print axioms pairingWeight_prod_labels

end GaussianTensorMoments
